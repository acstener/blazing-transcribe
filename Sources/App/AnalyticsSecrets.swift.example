// AnalyticsSecrets.swift.example — committed template (NOT compiled).
//
// Analytics keys are kept out of source control. To build with analytics, copy
// this file to `AnalyticsSecrets.swift` (which is gitignored) and fill in your
// PostHog key:
//
//     cp Sources/App/AnalyticsSecrets.swift.example Sources/App/AnalyticsSecrets.swift
//
// Left empty, the app compiles and runs fully — it just sends no telemetry,
// which is the default for source and fork builds.
enum AnalyticsSecrets {
    /// PostHog project (client ingest) API key. Empty → analytics disabled.
    static let postHogAPIKey = ""
    static let postHogHost = "https://eu.i.posthog.com"
    /// Set true only in the official distributed build (for dashboard filtering).
    static let isOfficialBuild = false
}
